<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default aman: hanya percayai CA sistem resmi dan tolak traffic cleartext (HTTP biasa) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain produksi: wajib HTTPS & tolak HTTP -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">sipeta.eu.cc</domain>
    </domain-config>

    <!-- Khusus lingkungan pengujian lokal (emulator / LAN intranet pengembang) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.10</domain>
        <domain includeSubdomains="true">192.168.1.42</domain>
        <domain includeSubdomains="true">192.168.1.47</domain>
        <domain includeSubdomains="true">192.168.1.7</domain>
    </domain-config>

    <!-- Sertifikat user (seperti proxy/Burp) HANYA diizinkan pada build DEBUG -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
