<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background: dark capsule with gold outline -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#40051214" />
            <stroke
                android:width="1.5dp"
                android:color="#A98F4F" />
        </shape>
    </item>

    <!-- Progress fill: gold gradient capsule -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#B38938"
                    android:centerColor="#FDE047"
                    android:endColor="#EAB308" />
            </shape>
        </scale>
    </item>
</layer-list>
