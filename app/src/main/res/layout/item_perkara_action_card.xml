<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAction"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Badge & Accent Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_filter_chip_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#00897B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                tools:text="HASIL P-21 (LENGKAP)" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/viewAccentDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_timeline_dot" />
        </LinearLayout>

        <!-- Action Specific Title -->
        <TextView
            android:id="@+id/tvActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Proses Berkas Lengkap (P-21)" />

        <!-- One-sentence SOP Description -->
        <TextView
            android:id="@+id/tvActionDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#475569"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            tools:text="Menyatakan hasil penelitian berkas telah lengkap memenuhi syarat formil dan materiil (P-21)." />

        <!-- Impact / Next Stage Info Container -->
        <LinearLayout
            android:id="@+id/layoutImpactContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivImpactIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#64748B"
                android:contentDescription="Dampak" />

            <TextView
                android:id="@+id/tvActionImpact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Tahap berikutnya: P-21 — Menunggu Penyerahan Tahap II" />
        </LinearLayout>

        <!-- Specific Trigger Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExecuteAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Proses Berkas Lengkap (P-21)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#00897B"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
