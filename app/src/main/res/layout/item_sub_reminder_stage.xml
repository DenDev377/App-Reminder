<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Bullet dot indicator -->
        <View
            android:id="@+id/viewStageDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_timeline_dot" />

        <!-- Nama Tahap & Jenis Reminder -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubStageTahap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Koordinasi Awal"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubStageJenis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                tools:text="SLA Koordinasi Awal"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Badge Status Log -->
        <TextView
            android:id="@+id/tvSubStageStatusLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_logout_badge"
            android:backgroundTint="#EF4444"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            tools:text="Selesai (Overdue)"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sub row: Periode SLA & Sisa Hari -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSubStagePeriode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="15 Okt 2026  ➔  18 Okt 2026"
            android:textColor="#334155"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSubStageSisaHari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Lewat 2 Hari"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Antar Tahap -->
    <View
        android:id="@+id/viewSubStageDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="#F1F5F9" />

</LinearLayout>
