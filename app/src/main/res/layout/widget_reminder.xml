<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Widget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/logo_kejaksaan"
            android:contentDescription="Logo Kejaksaan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIPETA KEJAKSAAN"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetSummaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memuat status perkara..."
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnWidgetRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Segarkan Widget" />
    </LinearLayout>

    <!-- Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#E2E8F0" />

    <!-- Content Slot 1 -->
    <LinearLayout
        android:id="@+id/layoutWidgetItem1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvWidgetDot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetNomor1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Perkara #..."
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetTahap1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tahap..."
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetSisa1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sisa..."
            android:textColor="#DC2626"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Slot 2 -->
    <LinearLayout
        android:id="@+id/layoutWidgetItem2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvWidgetDot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟡"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetNomor2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Perkara #..."
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetTahap2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tahap..."
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWidgetSisa2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sisa..."
            android:textColor="#D97706"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State (jika tidak ada perkara mendesak) -->
    <LinearLayout
        android:id="@+id/layoutWidgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Seluruh batas waktu perkara terkendali."
            android:textColor="#059669"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer Timestamp -->
    <TextView
        android:id="@+id/tvWidgetFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="Sentuh untuk buka SIPETA"
        android:textColor="#94A3B8"
        android:textSize="9sp" />

</LinearLayout>

