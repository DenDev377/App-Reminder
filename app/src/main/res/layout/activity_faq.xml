<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header Batik ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ic_batik_header"
                android:contentDescription="Batik Header" />

            <!-- Top Action Bar -->
            <LinearLayout
                android:id="@+id/topActionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back Button -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_circle_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF"
                        android:contentDescription="Kembali" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pusat Bantuan (FAQ)"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kejaksaan Negeri OKU"
                        android:textColor="#CCFBF1"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ── Intro Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_role_badge">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_faq"
                            app:tint="#0D9488"
                            android:contentDescription="FAQ Icon" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequently Asked Questions"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pertanyaan seputar aplikasi SIPETA"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── FAQ Items Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <!-- Q1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Apa fungsi utama aplikasi SIPETA?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="SIPETA (Sistem Pengingat Tahapan Perkara) berfungsi untuk membantu jaksa dan pegawai Kejaksaan memantau linimasa perkara, mengawal batas waktu (SLA) setiap tahapan prapenuntutan secara otomatis (H-3, Jatuh Tempo, dan Overdue), mengelola data perkara, serta membaca berita resmi kejaksaan secara terpadu."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. Bagaimana cara melihat reminder batas waktu perkara?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pengingat perkara yang mendesak ditampilkan langsung pada kartu 'Perhatian Ekstra' di Dashboard. Untuk melihat seluruh daftar pengingat aktif atau filter urgensi (H-3, Jatuh Tempo, Overdue), Anda dapat membuka menu 'Reminder' atau menu 'Timeline'."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Kapan pengingat jadwal sidang dikirimkan?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pengingat dikirimkan secara otomatis melalui Push Notification HP (FCM) dan kartu pengingat saat tahapan perkara mendekati batas waktu (H-3), hari jatuh tempo, maupun saat melewati batas waktu (Overdue). Pastikan izin notifikasi aktif di pengaturan HP Anda."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="4. Mengapa saya tidak menerima notifikasi?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Jika notifikasi tidak masuk, periksa beberapa hal berikut:\n1. Izinkan notifikasi di Pengaturan HP > Aplikasi > Reminders > Notifikasi.\n2. Pastikan HP tidak dalam mode 'Hemat Baterai Ketat' yang menonaktifkan proses latar belakang.\n3. Pastikan nomor HP di halaman Profil sudah sesuai."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5. Bagaimana cara ganti nomor HP atau sandi?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Buka halaman Profil Anda:\n• Klik menu 'Nomor HP' untuk memperbarui kontak WhatsApp/SMS.\n• Klik menu 'Kata Sandi' untuk mengganti password login akun Anda."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="6. Siapa saja yang dapat menggunakan aplikasi ini?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Aplikasi ini khusus untuk keperluan kedinasan internal Kejaksaan Negeri OKU, diperuntukkan bagi Jaksa Penuntut Umum (JPU), staf Pidum/Pidsus/Datun, serta pejabat struktural yang terdaftar di sistem."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Q7 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dev_item"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="7. Terjadi kendala teknis, harus hubungi siapa?"
                        android:textColor="#0D9488"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Silakan hubungi Administrator IT atau Subbagian Pembinaan Kejaksaan Negeri OKU untuk bantuan reset kata sandi, sinkronisasi perkara, atau perbaikan akun."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Divider & footer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CBD5E1"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="© 2026 Kejaksaan Negeri OKU. Hak Cipta Dilindungi."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

