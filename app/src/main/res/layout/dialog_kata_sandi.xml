<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Icon + Judul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_menu_item_circle">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="#00897B"
                android:contentDescription="Kata Sandi" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ganti Kata Sandi"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Masukkan kata sandi lama dan baru"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kata Sandi Lama -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kata Sandi Saat Ini"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Masukkan kata sandi saat ini"
            android:inputType="textPassword"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnToggleCurrent"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye_off"
            app:tint="#94A3B8"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tampilkan" />
    </LinearLayout>

    <!-- Kata Sandi Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kata Sandi Baru"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Min. 8 karakter"
            android:inputType="textPassword"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnToggleNew"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye_off"
            app:tint="#94A3B8"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tampilkan" />
    </LinearLayout>

    <!-- Konfirmasi Kata Sandi Baru -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Kata Sandi Baru"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Ulangi kata sandi baru"
            android:inputType="textPassword"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnToggleConfirm"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye_off"
            app:tint="#94A3B8"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tampilkan" />
    </LinearLayout>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvPasswordError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
