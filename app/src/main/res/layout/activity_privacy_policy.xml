<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header Batik ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ic_batik_header"
                android:contentDescription="Batik Header" />

            <!-- Top Action Bar -->
            <LinearLayout
                android:id="@+id/topActionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back Button -->
                <FrameLayout
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_circle_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#FFFFFF"
                        android:contentDescription="Kembali" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kebijakan Privasi"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kejaksaan Negeri OKU"
                        android:textColor="#CCFBF1"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ── Intro Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_role_badge">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield"
                            app:tint="#0D9488"
                            android:contentDescription="Shield" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Privasi &amp; Perlindungan Data"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terakhir Diperbarui: 19 Nov 2026"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kejaksaan Negeri Ogan Komering Ulu (OKU) berkomitmen penuh untuk menjamin privasi, kerahasiaan, serta keamanan seluruh informasi dan data penanganan perkara dalam aplikasi SIPETA (Sistem Pengingat Tahapan Perkara)."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 1. Data yang Dikumpulkan ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#0D9488" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="1. Data yang Kami Kumpulkan"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Untuk mendukung kelancaran layanan pengingat batas waktu dan pemantauan tahapan perkara, aplikasi SIPETA mengumpulkan dan memproses kategori data berikut secara terbatas untuk kepentingan kedinasan:\n\n• Data Profil Aparatur: Nama lengkap, NIP/NRP, pangkat/golongan, jabatan kedinasan, email dinas, dan foto profil yang digunakan untuk verifikasi dan autentikasi resmi jaksa/pegawai.\n• Data Kontak Kedinasan: Nomor telepon kedinasan yang didaftarkan pada profil pengguna untuk kebutuhan verifikasi akun dan koordinasi internal penanganan perkara.\n• Data Administrasi Perkara &amp; SLA: Nomor perkara/SPDP, identitas tersangka, tahapan prapenuntutan (SPDP, P-16, P-17, P-24, P-18/P-19, P-21, hingga Tahap II), jaksa penelaah/peneliti, penyidik kepolisian, tanggal register, serta batas waktu (SLA) tahapan perkara sesuai KUHAP dan SOP Kejaksaan RI.\n• Token Perangkat &amp; Sesi Aplikasi: Token Firebase Cloud Messaging (FCM) unik untuk menghantarkan alarm dan notifikasi pengingat batas waktu ke perangkat Android Anda, serta token sesi Bearer terenkripsi untuk menjaga keamanan komunikasi saat aplikasi aktif."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 2. Penggunaan Informasi ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#0D9488" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="2. Tujuan Penggunaan Data"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seluruh informasi yang dikumpulkan digunakan semata-mata untuk tujuan kedinasan internal Kejaksaan Negeri OKU, meliputi:\n\n• Pengingat Batas Waktu Otomatis: Menghitung secara otomatis sisa hari dan memicu pengingat tahapan perkara (H-3, Jatuh Tempo, dan Overdue) guna mencegah keterlambatan penanganan perkara pidana umum sesuai SOP.\n• Autentikasi &amp; Validasi Hak Akses: Memastikan bahwa hanya jaksa dan aparatur penegak hukum yang sah dan memiliki wewenang kedinasan yang dapat membuka serta mengelola berkas perkara.\n• Pemantauan Linimasa &amp; Audit Trail: Menyajikan riwayat tahapan perkara secara transparan dan akuntabel dari penerimaan SPDP hingga pelaksanaan Tahap II atau penghentian perkara sesuai SOP Kejaksaan RI.\n• Efisiensi Koordinasi Penegakan Hukum: Mempermudah jaksa peneliti dalam memantau perkembangan penyidikan dari penyidik kepolisian secara terstruktur dan terukur."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 3. Keamanan & Kerahasiaan ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#0D9488" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="3. Keamanan &amp; Kerahasiaan Data"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kejaksaan Negeri OKU menerapkan standar keamanan informasi berlapis guna menjamin integritas, kerahasiaan, dan ketersediaan data penanganan perkara:\n\n• Enkripsi Komunikasi Data (In-Transit Encryption): Seluruh lalu lintas transmisi data antara aplikasi Android dan server SIPETA dilindungi menggunakan protokol enkripsi standar industri Transport Layer Security (TLS 1.2 / TLS 1.3) dan HTTPS dengan sertifikat SSL terverifikasi untuk mencegah intersepsi data atau Man-in-the-Middle (MitM).\n\n• Keamanan Token Sesi &amp; Isolasi Sandbox (At-Rest Storage): Sesi autentikasi menggunakan Bearer Token dengan masa aktif terbatas. Token sesi disimpan di dalam penyimpanan privat lokal perangkat (Android App Sandbox) yang terisolasi dari aplikasi lain. Token akan otomatis dihancurkan (auto-clear) seketika saat pengguna melakukan logout atau sesi kedaluwarsa (401 Unauthorized), dan pengguna diarahkan kembali ke layar login.\n\n• Pengamanan Kredensial &amp; Sandi: Kata sandi akun tidak pernah disimpan dalam bentuk teks polos (plaintext). Seluruh kata sandi dienkripsi menggunakan algoritma cryptographic hashing satu arah yang kuat (Bcrypt) di sisi server.\n\n• Pembatasan Hak Akses Berjenjang (Role-Based Access Control / RBAC): Akses terhadap data perkara dan fitur penanganan dibatasi secara ketat berdasarkan kewenangan kedinasan (Jaksa Penuntut Umum, Pejabat Struktural, dan Staf Administrasi) sehingga pengguna hanya dapat mengakses data yang relevan dengan tugas kedinasannya.\n\n• Integritas Audit Trail: Setiap riwayat perubahan tahapan perkara dan log reminder dicatat secara kronologis dalam sistem audit trail yang tidak dapat diubah (immutable log), menjamin transparansi serta akuntabilitas pengawasan.\n\n• Kerahasiaan Berkas Tanpa Pihak Ketiga: Seluruh data perkara berstatus rahasia kedinasan peradilan pidana. Kejaksaan Negeri OKU menjamin tidak ada data yang dibagikan, dialihkan, disewakan, atau dijual kepada pihak ketiga di luar instansi penegak hukum yang berwenang."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 4. Kontak & Kantor ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="#0D9488" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="4. Pengelolaan Akun &amp; Kontak Resmi"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Pembaruan Data Mandiri: Pengguna dapat memperbarui nomor telepon kontak, foto profil, dan kata sandi akun secara mandiri melalui menu Pengaturan Profil di aplikasi.\n• Layanan Bantuan Administrator: Apabila terjadi kendala autentikasi akun, mutasi wewenang perkara, atau indikasi masalah keamanan, silakan hubungi Administrator Sistem:\n\nKejaksaan Negeri Ogan Komering Ulu\nJl. Lintas Sumatera No. 1, Baturaja\nKab. Ogan Komering Ulu, Sumatera Selatan\nEmail: kejari.oku@kejaksaan.go.id"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CBD5E1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="© 2026 Kejaksaan Negeri OKU. Hak Cipta Dilindungi."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
