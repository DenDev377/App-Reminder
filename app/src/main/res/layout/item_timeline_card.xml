<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTimeline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Nomor Perkara & Tahap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timeline"
                app:tint="#00897B"
                android:contentDescription="Icon Timeline" />

            <TextView
                android:id="@+id/tvNomorPerkara"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                tools:text="008/PIDUM"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Badge Tahap -->
            <TextView
                android:id="@+id/tvTahap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#E0F2FE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:text="Koordinasi Awal"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Body: Status Kegiatan -->
        <TextView
            android:id="@+id/tvStatusKegiatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="Overdue / Tindak Lanjut SOP Form-1B &amp; Form-1C"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Body: Tersangka Box (jika ada) -->
        <LinearLayout
            android:id="@+id/layoutCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tersangka: "
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCatatan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="1. Budi Santoso"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#F1F5F9" />

        <!-- Footer: Info Penyidik & Badge Buka Timeline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTanggalKejadian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Penyidik: Polsek Tanjung Karang Barat"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Button Badge Buka Timeline -->
            <TextView
                android:id="@+id/tvBadgeActor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#E0F2FE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Lihat Timeline &#8594;"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>