<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/imgSectionIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_alarm"
        app:tint="#DC2626"
        android:contentDescription="Section Icon" />

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:text="Perlu Tindakan Hari Ini"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_logout_badge"
        android:backgroundTint="#F1F5F9"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="2"
        android:textColor="#475569"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
