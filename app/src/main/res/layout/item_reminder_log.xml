<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReminderLog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Header: Icon, Nomor Perkara (SPDP), Badge Total Tahap, Badge Urgensi Utama -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_perkara"
                app:tint="#00897B"
                android:contentDescription="Icon Perkara" />

            <TextView
                android:id="@+id/tvNomorPerkara"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                tools:text="010/Pidum"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Badge Jumlah Tahap SLA -->
            <TextView
                android:id="@+id/tvBadgeTotalTahap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#E0F2FE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="2 Tahap SLA"
                android:textColor="#0369A1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Badge Status Urgensi Utama (Overdue / Aktif / Selesai) -->
            <TextView
                android:id="@+id/tvPrimaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#EF4444"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                tools:text="Overdue"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Tahap Saat Ini & Status Perkara Saat Ini -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tahap Saat Ini:"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTahapSaatIni"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                tools:text="Monitoring Penyidikan"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusSaatIni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="Status: Overdue / Tindak Lanjut SOP Form-1B &amp; Form-1C"
            android:textColor="#475569"
            android:textSize="11sp" />

        <!-- 3. Tersangka -->
        <TextView
            android:id="@+id/tvTersangka"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Tersangka: Tersangka Budi"
            android:textColor="#334155"
            android:textSize="12sp" />

        <!-- 4. Jaksa & Penyidik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJaksa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Jaksa: Fadhol, S.H."
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvPenyidik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Penyidik: Aiptu Joko"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#F1F5F9" />

        <!-- 5. Riwayat Tahapan SLA Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvSlaSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Perjalanan SLA Perkara:"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Dynamic Sub-stages Container -->
            <LinearLayout
                android:id="@+id/layoutSlaStagesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Toggle Expand / Collapse Button (jika tahapan > 2) -->
            <TextView
                android:id="@+id/tvToggleExpand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:text="Lihat Semua Tahapan ▼"
                android:textColor="#00897B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 6. Footer: Action Menuju Detail Perkara -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Data audit trail SLA perkara"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnViewPerkara"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#E0F2FE"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Detail Perkara &amp; Timeline &#8594;"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
