<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardReminder"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#FECACA"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Icon, Jenis SLA, and Badge Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgReminderIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_alarm"
                app:tint="#DC2626"
                android:contentDescription="Icon Reminder" />

            <TextView
                android:id="@+id/tvReminderJenis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SLA P-16"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Badge Status Urgensi -->
            <TextView
                android:id="@+id/tvReminderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_badge"
                android:backgroundTint="#EF4444"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Jatuh Tempo"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nomor Perkara -->
        <TextView
            android:id="@+id/tvReminderNomor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nomor: B123-PPP"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tersangka -->
        <TextView
            android:id="@+id/tvReminderTersangka"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tersangka: -"
            android:textColor="#475569"
            android:textSize="11sp" />

        <!-- Tahap -->
        <TextView
            android:id="@+id/tvReminderTahap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tahap Pra Penuntutan (PRATUT)"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#F1F5F9" />

        <!-- Footer: Deadline & Sisa Hari -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deadline:"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvReminderDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="08 Okt 2026"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvReminderSisaHari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sisa: 0 Hari"
                android:textColor="#DC2626"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
