<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_workflow">

    <!-- Header Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDialogHeaderIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_menu_item_circle"
            android:padding="8dp"
            android:src="@drawable/ic_check_circle"
            app:tint="#00897B"
            android:contentDescription="Icon Konfirmasi" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfirmasi Tindakan Perkara"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SOP Alur Penanganan Perkara SIPETA"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Info Box: Action Details & Impact -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvDialogNomorPerkara"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00897B"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Perkara: 002/PIDUM" />

            <TextView
                android:id="@+id/tvDialogActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Proses Berkas Lengkap (P-21)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#E2E8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimasi Dampak Alur:"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogActionImpact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Tahap berikutnya: P-21 — Status: Menunggu Penyerahan Tahap II" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Field 1: Tanggal Pelaksanaan -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tanggal Pelaksanaan Tindakan"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutTanggalPicker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edittext"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_alarm"
            app:tint="#64748B"
            android:contentDescription="Kalender" />

        <TextView
            android:id="@+id/tvDialogTanggal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="#0F172A"
            android:textSize="14sp"
            tools:text="2026-10-27" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_expand_more"
            app:tint="#64748B"
            android:contentDescription="Pilih Tanggal" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Nilai awal hari ini. Klik untuk mengubah jika tanggal berbeda."
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <!-- Field 2: Catatan / Keterangan Opsional -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Catatan Tambahan (Opsional)"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogCatatan"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_edittext"
        android:gravity="top|start"
        android:hint="Tambahkan keterangan tindak lanjut jika diperlukan..."
        android:maxLength="1000"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="13sp" />

    <!-- Error Message in Dialog -->
    <TextView
        android:id="@+id/tvDialogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Terjadi kesalahan validasi"
        tools:visibility="visible" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbDialogLoading"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Batal"
            android:textColor="#64748B"
            android:textSize="13sp"
            app:strokeColor="#CBD5E1"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:layout_marginStart="10dp"
            android:minHeight="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Konfirmasi Tindakan"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#00897B"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
